# ==============================================================================
# Crystal Notebook - Master Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (Render Web Service)
# ------------------------------------------------------------------------------

# Database Connection String:
# Local Development (SQLite):
DATABASE_URL=sqlite:///./crystal_notebook.db
# Production (Render PostgreSQL):
# DATABASE_URL=postgresql://crystal_user:your_password@dpg-xxx-a.oregon-postgres.render.com/crystal_notebook

# JWT Secret Key (Generate a random 32+ char hex key: `openssl rand -hex 32`)
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-characters-long
SECRET_KEY=your-super-secret-jwt-key-min-32-characters-long

# Production Frontend URL for CORS (Allow your Render Static Site origin)
FRONTEND_URL=https://crystal-notebook.onrender.com

# Access Token Expiry (10080 minutes = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional Server Port (Dynamically provided by Render as $PORT)
PORT=8000

# ------------------------------------------------------------------------------
# Frontend Service Configuration (Render Static Site)
# ------------------------------------------------------------------------------

# Backend API URL for client-side requests:
# Production: Set to your deployed Render backend web service URL
VITE_API_URL=https://crystal-notebook-api.onrender.com
# Local Development:
# VITE_API_URL=http://localhost:8000
