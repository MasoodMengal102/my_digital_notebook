# Secret key for JWT signing (Replace with a strong random secret in production)
SECRET_KEY=crystal-notebook-super-secret-jwt-key-2026-production-grade

# Database URL
# For local SQLite:
DATABASE_URL=sqlite:///./crystal_notebook.db
# For PostgreSQL (Production):
# DATABASE_URL=postgresql://user:password@localhost:5432/crystal_notebook

# Token Expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
