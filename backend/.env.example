# ==========================================
# Crystal Notebook - Backend Environment Variables
# ==========================================

# Database Connection URL:
# For Local Development (SQLite):
DATABASE_URL=sqlite:///./crystal_notebook.db
# For Render Production (PostgreSQL):
# Render automatically provides DATABASE_URL when a PostgreSQL database is attached.
# Example: postgresql://username:password@dpg-xxx-a.oregon-postgres.render.com/crystal_notebook

# JWT Secret Key (Generate a random 32+ character key, e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=crystal-notebook-super-secret-jwt-key-2026-production-grade
SECRET_KEY=crystal-notebook-super-secret-jwt-key-2026-production-grade

# Production Frontend URL for CORS (Allow your Render Static Site origin)
# Example: https://crystal-notebook.onrender.com (comma-separated if multiple)
FRONTEND_URL=https://crystal-notebook.onrender.com

# Access token expiry in minutes (10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional Server Port (Render sets this dynamically via $PORT)
PORT=8000

